function render(){renderPlayers();renderTeam();$('status').textContent=`Datos de semana ${week}: ${stamp(board().retrievedAt)} · copia guardada o última consulta`}
function detail(id){const p=board().players.find(x=>x.id===id);if(!p)return;$('detailBody').innerHTML=`<small>${esc(p.position)} · ${esc(p.team)} · SEMANA ${week}</small><h2>${esc(p.name)}</h2><p>${esc(opponent(p))}${p.game?.date?' · '+esc(stamp(p.game.date)):''}</p><p>${esc(p.game?.venue||'')}</p><div class="points" style="font-size:48px">${fmt(p.points)} PPR</div><h3>${esc(p.advice?.label||'Revisar')}</h3><p>${esc(p.advice?.reason||'Sin recomendación disponible.')}</p>${p.injury?`<p class="danger">Reporte actual: ${esc(p.injury)}</p>`:''}<h3>Desglose estimado</h3>${Object.entries(p.breakdown||{}).map(([k,v])=>`<p>${({passing:'Pase',rushing:'Carrera',receiving:'Recepciones',turnovers:'Pérdidas',conversions:'Conversiones'})[k]||esc(k)}: <b>${fmt(v)}</b></p>`).join('')}<small>Estimación, no resultado garantizado. Fuentes consultadas: ${esc(stamp(board().retrievedAt))}.</small>`;$('detail').showModal()}
document.addEventListener('click',e=>{const p=e.target.closest('[data-player]');if(p)detail(p.dataset.player);const t=e.target.closest('[data-tab]');if(t){for(const id of ['players','team','news'])$(id).classList.toggle('hidden',id!==t.dataset.tab);document.querySelectorAll('[data-tab]').forEach(x=>x.classList.toggle('active',x===t))}});$('slots').addEventListener('change',e=>{const s=e.target.dataset.slot;if(s){lineup[s]=e.target.value;if(!e.target.value)delete lineup[s];persist();renderTeam()}});$('name').oninput=persist;$('close').onclick=()=>$('detail').close();$('search').oninput=()=>{shown=50;renderPlayers()};$('position').onchange=$('top').onchange=()=>{shown=50;renderPlayers()};$('more').onclick=()=>{shown+=50;renderPlayers()};$('week').onchange=()=>{week=Number($('week').value);shown=50;render();refresh()};
const num=(s,k)=>Number(s[k])||0;function calc(s){const n=k=>num(s,k);return{passing:n('pass_yd')/25+n('pass_td')*4,rushing:n('rush_yd')/10+n('rush_td')*6,receiving:n('rec')+n('rec_yd')/10+n('rec_td')*6,turnovers:-2*(n('pass_int')+n('fum_lost')),conversions:2*(n('pass_2pt')+n('rush_2pt')+n('rec_2pt'))}}
async function fetchJSON(url){const r=await fetch(url,{signal:AbortSignal.timeout(18000)});if(!r.ok)throw Error(r.status);return r.json()}
async function refresh(){if(busy)return;busy=true;$('refresh').disabled=true;const requested=week;$('status').textContent='Consultando fuentes…';const tasks=await Promise.allSettled([fetchJSON(`https://api.sleeper.app/projections/nfl/2026/${requested}?season_type=regular&position[]=QB&position[]=RB&position[]=WR&position[]=TE`),fetchJSON('https://site.api.espn.com/apis/site/v2/sports/football/nfl/news')]);
if(tasks[0].status==='fulfilled'&&Array.isArray(tasks[0].value)&&tasks[0].value.length){const m=new Map;for(const x of tasks[0].value){if(Number(x.season)!==2026||Number(x.week)!==requested||x.category!=='proj')continue;const old=m.get(String(x.player_id));if(!old||x.company==='rotowire'&&old.company!=='rotowire'||x.company===old.company&&Number(x.updated_at)>Number(old.updated_at))m.set(String(x.player_id),x)}const b=boards[requested];for(const p of b.players){const x=m.get(p.id);if(x&&(!x.team||x.team===p.team)&&!p.bye&&Object.keys(x.stats||{}).length){p.breakdown=calc(x.stats);p.points=Math.round(Object.values(p.breakdown).reduce((a,b)=>a+b,0)*100)/100;p.injury=x.player?.injury_status??p.injury}else{p.points=null;p.breakdown=null}}b.players.sort((a,b)=>(b.points??-999)-(a.points??-999));const ranks={};for(const p of b.players){const r=ranks[p.position]=(ranks[p.position]||0)+1;p.advice=p.bye?{label:'Descanso',reason:'No juega esta semana.'}:p.injury?{label:'Revisar lesión',reason:'Confirma el reporte oficial antes de alinear.'}:p.points==null?{label:'Sin proyección',reason:'La fuente no ofrece una estimación para este jugador.'}:{label:r<=(['QB','TE'].includes(p.position)?12:24)?'Opción titular':'Revisar alternativas',reason:`Puesto ${r} de ${p.position} por proyección. Compara con tu alineación; el calendario incluido corresponde a la copia guardada.`}}b.retrievedAt=new Date().toISOString();render();$('status').textContent=`Proyecciones actualizadas: ${stamp(b.retrievedAt)} · calendario guardado`;}else{render();$('status').textContent=`Sin actualización de proyecciones. Copia guardada del ${stamp(board().retrievedAt)}.`}
if(tasks[1].status==='fulfilled'&&Array.isArray(tasks[1].value.articles)){news=tasks[1].value.articles.map(n=>({headline:n.headline,date:n.published,url:n.links?.web?.href||''}));$('newsStatus').textContent='Noticias actualizadas: '+stamp(Date.now());renderNews()}else $('newsStatus').textContent='Noticias guardadas; no se pudo consultar la fuente.';busy=false;$('refresh').disabled=false;if(week!==requested)refresh()}
$('refresh').onclick=refresh;render();renderNews();$('newsStatus').textContent='Noticias incluidas en la copia del archivo.';refresh();setInterval(()=>{if(!document.hidden)refresh()},300000);
</script></html>